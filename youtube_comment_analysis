      "source": [
        "from googleapiclient.discovery import build\n",
        "\n",
        "youtube = build(\n",
        "    \"youtube\",\n",
        "    \"v3\",\n",
        "    developerKey=api_key\n",
        ")\n",
        "\n",
        "print(\"✅ YouTube API connected successfully!\")"

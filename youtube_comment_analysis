        "# ============================================================\n",
        "# STEP 27: GRADIO INTERFACE\n",
        "# ============================================================\n",
        "\n",
        "import gradio as gr\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from wordcloud import WordCloud\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "from nltk.sentiment.vader import SentimentIntensityAnalyzer\n",
        "from googleapiclient.discovery import build\n",
        "from urllib.parse import urlparse, parse_qs\n",
        "import re\n",
        "import os\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SENTIMENT ANALYZER\n",
        "# ============================================================\n",
        "\n",
        "sia = SentimentIntensityAnalyzer()\n",
        "\n",
        "\n",
        "def get_sentiment(text):\n",
        "\n",
        "    score = sia.polarity_scores(text)[\"compound\"]\n",
        "\n",
        "    if score >= 0.05:\n",
        "        return \"Positive\"\n",
        "\n",
        "    elif score <= -0.05:\n",
        "        return \"Negative\"\n",
        "\n",
        "    else:\n",
        "        return \"Neutral\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# TEXT CLEANING\n",
        "# ============================================================\n",
        "\n",
        "def clean_text(text):\n",
        "\n",
        "    text = str(text)\n",
        "\n",
        "    text = text.lower()\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"https?://\\S+|www\\.\\S+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"@\\w+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"#\",\n",
        "        \"\",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"\\s+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    return text.strip()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# VIDEO ID EXTRACTION\n",
        "# ============================================================\n",
        "\n",
        "def extract_video_id(url):\n",
        "\n",
        "    try:\n",
        "\n",
        "        parsed_url = urlparse(url)\n",
        "\n",
        "        video_id = parse_qs(\n",
        "            parsed_url.query\n",
        "        ).get(\"v\", [None])[0]\n",
        "\n",
        "        if video_id:\n",
        "            return video_id\n",
        "\n",
        "        # Handle youtu.be links\n",
        "        if \"youtu.be\" in parsed_url.netloc:\n",
        "\n",
        "            video_id = parsed_url.path.strip(\"/\")\n",
        "\n",
        "            if video_id:\n",
        "                return video_id[:11]\n",
        "\n",
        "        return None\n",
        "\n",
        "    except:\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ANALYSIS FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def analyze_video(youtube_url):\n",
        "\n",
        "    if not youtube_url.strip():\n",
        "\n",
        "        return (\n",
        "            \"❌ Please enter a YouTube URL.\",\n",
        "            \"\",\n",
        "            \"\",\n",
        "            \"\",\n",
        "            \"\",\n",
        "            None,\n",
        "            None,\n",
        "            None,\n",
        "            None\n",
        "        )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Extract Video ID\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    video_id = extract_video_id(\n",
        "        youtube_url\n",
        "    )\n",
        "\n",
        "    if video_id is None:\n",
        "\n",
        "        return (\n",
        "            \"❌ Invalid YouTube URL.\",\n",
        "            \"\",\n",
        "            \"\",\n",
        "            \"\",\n",
        "            \"\",\n",
        "            None,\n",
        "            None,\n",
        "            None,\n",
        "            None\n",
        "        )\n",
        "\n",
        "\n",
        "    try:\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Connect to YouTube API\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        youtube = build(\n",
        "            \"youtube\",\n",
        "            \"v3\",\n",
        "            developerKey=api_key\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Get comments\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        comments = []\n",
        "\n",
        "        next_page_token = None\n",
        "\n",
        "\n",
        "        while len(comments) < 500:\n",
        "\n",
        "            request = youtube.commentThreads().list(\n",
        "\n",
        "                part=\"snippet\",\n",
        "\n",
        "                videoId=video_id,\n",
        "\n",
        "                maxResults=100,\n",
        "\n",
        "                pageToken=next_page_token,\n",
        "\n",
        "                textFormat=\"plainText\"\n",
        "            )\n",
        "\n",
        "            response = request.execute()\n",
        "\n",
        "\n",
        "            for item in response.get(\n",
        "                \"items\",\n",
        "                []\n",
        "            ):\n",
        "\n",
        "                snippet = (\n",
        "                    item[\n",
        "                        \"snippet\"\n",
        "                    ][\n",
        "                        \"topLevelComment\"\n",
        "                    ][\n",
        "                        \"snippet\"\n",
        "                    ]\n",
        "                )\n",
        "\n",
        "\n",
        "                comments.append({\n",
        "\n",
        "                    \"comment\":\n",
        "                    snippet[\n",
        "                        \"textDisplay\"\n",
        "                    ],\n",
        "\n",
        "                    \"like_count\":\n",
        "                    snippet[\n",
        "                        \"likeCount\"\n",
        "                    ]\n",
        "                })\n",
        "\n",
        "\n",
        "                if len(comments) >= 500:\n",
        "                    break\n",
        "\n",
        "\n",
        "            next_page_token = response.get(\n",
        "                \"nextPageToken\"\n",
        "            )\n",
        "\n",
        "\n",
        "            if not next_page_token:\n",
        "                break\n",
        "\n",
        "\n",
        "        if len(comments) == 0:\n",
        "\n",
        "            return (\n",
        "                \"❌ No comments found. Comments may be disabled.\",\n",
        "                \"\",\n",
        "                \"\",\n",
        "                \"\",\n",
        "                \"\",\n",
        "                None,\n",
        "                None,\n",
        "                None,\n",
        "                None\n",
        "            )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # DataFrame\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        df_result = pd.DataFrame(\n",
        "            comments\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Cleaning\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        df_result[\n",
        "            \"clean_comment\"\n",
        "        ] = df_result[\n",
        "            \"comment\"\n",
        "        ].apply(\n",
        "            clean_text\n",
        "        )\n",
        "\n",
        "\n",
        "        df_result = df_result[\n",
        "            df_result[\n",
        "                \"clean_comment\"\n",
        "            ].str.strip() != \"\"\n",
        "        ].reset_index(\n",
        "            drop=True\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Sentiment\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        df_result[\n",
        "            \"sentiment\"\n",
        "        ] = df_result[\n",
        "            \"clean_comment\"\n",
        "        ].apply(\n",
        "            get_sentiment\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # TF-IDF\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        tfidf_vectorizer = TfidfVectorizer(\n",
        "\n",
        "            max_features=1000,\n",
        "\n",
        "            stop_words=\"english\"\n",
        "        )\n",
        "\n",
        "\n",
        "        tfidf_matrix = (\n",
        "            tfidf_vectorizer.fit_transform(\n",
        "                df_result[\n",
        "                    \"clean_comment\"\n",
        "                ]\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Find optimal K using Elbow Method\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        max_k = min(\n",
        "            8,\n",
        "            len(df_result) - 1\n",
        "        )\n",
        "\n",
        "\n",
        "        if max_k < 2:\n",
        "\n",
        "            return (\n",
        "                \"❌ Not enough comments for clustering.\",\n",
        "                \"\",\n",
        "                \"\",\n",
        "                \"\",\n",
        "                \"\",\n",
        "                None,\n",
        "                None,\n",
        "                None,\n",
        "                None\n",
        "            )\n",
        "\n",
        "\n",
        "        k_values = range(\n",
        "            2,\n",
        "            max_k + 1\n",
        "        )\n",
        "\n",
        "\n",
        "        inertias = []\n",
        "\n",
        "\n",
        "        for k in k_values:\n",
        "\n",
        "            model = KMeans(\n",
        "\n",
        "                n_clusters=k,\n",
        "\n",
        "                random_state=42,\n",
        "\n",
        "                n_init=10\n",
        "            )\n",
        "\n",
        "            model.fit(\n",
        "                tfidf_matrix\n",
        "            )\n",
        "\n",
        "            inertias.append(\n",
        "                model.inertia_\n",
        "            )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Use K = 4 when possible\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        if len(df_result) >= 4:\n",
        "\n",
        "            optimal_k = 4\n",
        "\n",
        "        else:\n",
        "\n",
        "            optimal_k = 2\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # K-Means\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        kmeans = KMeans(\n",
        "\n",
        "            n_clusters=optimal_k,\n",
        "\n",
        "            random_state=42,\n",
        "\n",
        "            n_init=10\n",
        "        )\n",
        "\n",
        "\n",
        "        df_result[\n",
        "            \"cluster\"\n",
        "        ] = kmeans.fit_predict(\n",
        "            tfidf_matrix\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Silhouette Score\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        if (\n",
        "            len(set(\n",
        "                df_result[\n",
        "                    \"cluster\"\n",
        "                ]\n",
        "            )) > 1\n",
        "        ):\n",
        "\n",
        "            silhouette = silhouette_score(\n",
        "\n",
        "                tfidf_matrix,\n",
        "\n",
        "                df_result[\n",
        "                    \"cluster\"\n",
        "                ]\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            silhouette = 0\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # SUMMARY\n",
        "        # ====================================================\n",
        "\n",
        "        total = len(df_result)\n",
        "\n",
        "\n",
        "        sentiment_counts = (\n",
        "            df_result[\n",
        "                \"sentiment\"\n",
        "            ].value_counts()\n",
        "        )\n",
        "\n",
        "\n",
        "        positive = sentiment_counts.get(\n",
        "            \"Positive\",\n",
        "            0\n",
        "        )\n",
        "\n",
        "        negative = sentiment_counts.get(\n",
        "            \"Negative\",\n",
        "            0\n",
        "        )\n",
        "\n",
        "        neutral = sentiment_counts.get(\n",
        "            \"Neutral\",\n",
        "            0\n",
        "        )\n",
        "\n",
        "\n",
        "        positive_pct = (\n",
        "            positive / total\n",
        "        ) * 100\n",
        "\n",
        "        negative_pct = (\n",
        "            negative / total\n",
        "        ) * 100\n",
        "\n",
        "        neutral_pct = (\n",
        "            neutral / total\n",
        "        ) * 100\n",
        "\n",
        "\n",
        "        summary = f\"\"\"\n",
        "# 🎥 YouTube NLP Analysis\n",
        "\n",
        "### Video ID\n",
        "`{video_id}`\n",
        "\n",
        "### Comments Analyzed\n",
        "**{total}**\n",
        "\n",
        "### Sentiment\n",
        "\n",
        "🟢 **Positive:** {positive} ({positive_pct:.2f}%)\n",
        "\n",
        "🟡 **Neutral:** {neutral} ({neutral_pct:.2f}%)\n",
        "\n",
        "🔴 **Negative:** {negative} ({negative_pct:.2f}%)\n",
        "\n",
        "### Clustering\n",
        "\n",
        "**Optimal K:** {optimal_k}\n",
        "\n",
        "**Silhouette Score:** {silhouette:.4f}\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # SENTIMENT GRAPH\n",
        "        # ====================================================\n",
        "\n",
        "        fig_sentiment = plt.figure(\n",
        "            figsize=(7, 5)\n",
        "        )\n",
        "\n",
        "\n",
        "        plt.bar(\n",
        "\n",
        "            sentiment_counts.index,\n",
        "\n",
        "            sentiment_counts.values\n",
        "        )\n",
        "\n",
        "\n",
        "        plt.title(\n",
        "            \"YouTube Comment Sentiment\"\n",
        "        )\n",
        "\n",
        "        plt.xlabel(\n",
        "            \"Sentiment\"\n",
        "        )\n",
        "\n",
        "        plt.ylabel(\n",
        "            \"Number of Comments\"\n",
        "        )\n",
        "\n",
        "        plt.tight_layout()\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # CLUSTER GRAPH\n",
        "        # ====================================================\n",
        "\n",
        "        cluster_counts = (\n",
        "            df_result[\n",
        "                \"cluster\"\n",
        "            ]\n",
        "            .value_counts()\n",
        "            .sort_index()\n",
        "        )\n",
        "\n",
        "\n",
        "        fig_cluster = plt.figure(\n",
        "            figsize=(7, 5)\n",
        "        )\n",
        "\n",
        "\n",
        "        plt.bar(\n",
        "\n",
        "            cluster_counts.index.astype(str),\n",
        "\n",
        "            cluster_counts.values\n",
        "        )\n",
        "\n",
        "\n",
        "        plt.title(\n",
        "            \"Comments per Cluster\"\n",
        "        )\n",
        "\n",
        "        plt.xlabel(\n",
        "            \"Cluster\"\n",
        "        )\n",
        "\n",
        "        plt.ylabel(\n",
        "            \"Number of Comments\"\n",
        "        )\n",
        "\n",
        "        plt.tight_layout()\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # WORD CLOUD\n",
        "        # ====================================================\n",
        "\n",
        "        all_text = \" \".join(\n",
        "            df_result[\n",
        "                \"clean_comment\"\n",
        "            ].tolist()\n",
        "        )\n",
        "\n",
        "\n",
        "        if all_text.strip():\n",
        "\n",
        "            wordcloud = WordCloud(\n",
        "\n",
        "                width=1000,\n",
        "\n",
        "                height=500,\n",
        "\n",
        "                background_color=\"white\",\n",
        "\n",
        "                max_words=100\n",
        "            ).generate(\n",
        "                all_text\n",
        "            )\n",
        "\n",
        "\n",
        "            fig_wordcloud = plt.figure(\n",
        "                figsize=(12, 6)\n",
        "            )\n",
        "\n",
        "\n",
        "            plt.imshow(\n",
        "\n",
        "                wordcloud,\n",
        "\n",
        "                interpolation=\"bilinear\"\n",
        "            )\n",
        "\n",
        "\n",
        "            plt.axis(\"off\")\n",
        "\n",
        "            plt.title(\n",
        "                \"Most Frequent Words\"\n",
        "            )\n",
        "\n",
        "            plt.tight_layout()\n",
        "\n",
        "        else:\n",
        "\n",
        "            fig_wordcloud = None\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # TOP WORDS\n",
        "        # ====================================================\n",
        "\n",
        "        all_words = \" \".join(\n",
        "            df_result[\n",
        "                \"clean_comment\"\n",
        "            ]\n",
        "        ).split()\n",
        "\n",
        "\n",
        "        from collections import Counter\n",
        "\n",
        "\n",
        "        word_counts = Counter(\n",
        "            all_words\n",
        "        )\n",
        "\n",
        "\n",
        "        top_words = pd.DataFrame(\n",
        "\n",
        "            word_counts.most_common(20),\n",
        "\n",
        "            columns=[\n",
        "                \"Word\",\n",
        "                \"Frequency\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # FINAL TABLE\n",
        "        # ====================================================\n",
        "\n",
        "        final_table = df_result[\n",
        "            [\n",
        "                \"comment\",\n",
        "                \"clean_comment\",\n",
        "                \"like_count\",\n",
        "                \"sentiment\",\n",
        "                \"cluster\"\n",
        "            ]\n",
        "        ]\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # SAVE CSV\n",
        "        # ====================================================\n",
        "\n",
        "        csv_file = (\n",
        "            \"/content/\"\n",
        "            \"youtube_comment_nlp_analysis.csv\"\n",
        "        )\n",
        "\n",
        "\n",
        "        final_table.to_csv(\n",
        "\n",
        "            csv_file,\n",
        "\n",
        "            index=False\n",
        "        )\n",
        "\n",
        "\n",
        "        # ====================================================\n",
        "        # RETURN RESULTS\n",
        "        # ====================================================\n",
        "\n",
        "        return (\n",
        "\n",
        "            summary,\n",
        "\n",
        "            top_words,\n",
        "\n",
        "            final_table.head(20),\n",
        "\n",
        "            fig_sentiment,\n",
        "\n",
        "            fig_cluster,\n",
        "\n",
        "            fig_wordcloud,\n",
        "\n",
        "            csv_file,\n",
        "\n",
        "            \"✅ Analysis completed successfully!\",\n",
        "\n",
        "            None\n",
        "        )\n",
        "\n",
        "\n",
        "    except Exception as e:\n",
        "\n",
        "        error = str(e)\n",
        "\n",
        "\n",

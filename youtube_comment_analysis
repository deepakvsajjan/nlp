        "# ============================================\n",
        "# STEP 7: TEXT PREPROCESSING\n",
        "# ============================================\n",
        "\n",
        "import re\n",
        "\n",
        "def clean_text(text):\n",
        "\n",
        "    # Convert to string\n",
        "    text = str(text)\n",
        "\n",
        "    # Convert to lowercase\n",
        "    text = text.lower()\n",
        "\n",
        "    # Remove URLs\n",
        "    text = re.sub(\n",
        "        r\"https?://\\S+|www\\.\\S+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Remove @mentions\n",
        "    text = re.sub(\n",
        "        r\"@\\w+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Remove hashtag symbol but keep the word\n",
        "    text = re.sub(\n",
        "        r\"#\",\n",
        "        \"\",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Remove extra whitespace\n",
        "    text = re.sub(\n",
        "        r\"\\s+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    # Remove leading/trailing spaces\n",
        "    text = text.strip()\n",
        "\n",
        "    return text\n",
        "\n",
        "\n",
        "# Apply preprocessing\n",
        "df[\"clean_comment\"] = df[\"comment\"].apply(\n",
        "    clean_text\n",
        ")\n",
        "\n",
        "\n",
        "# Remove empty comments\n",
        "df = df[\n",
        "    df[\"clean_comment\"].str.strip() != \"\"\n",
        "].reset_index(drop=True)\n",
        "\n",
        "\n",
        "print(\"✅ Text preprocessing completed\")\n",
        "\n",
        "print(\n",
        "    \"Comments after cleaning:\",\n",
        "    len(df)\n",
        ")\n",
        "\n",
        "print(\"\\nOriginal vs Cleaned comments:\")\n",
        "\n",
        "display(\n",
        "    df[\n",
        "        [\n",
        "            \"comment\",\n",
        "            \"clean_comment\"\n",
        "        ]\n",
        "    ].head(10)\n",
        ")"

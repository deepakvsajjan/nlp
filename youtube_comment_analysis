        "\n",
        "# Count word frequency\n",
        "word_counts = Counter(all_words)\n",
        "\n",
        "# Get top 20 words\n",
        "top_20_words = word_counts.most_common(20)\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"TOP 20 MOST FREQUENT WORDS\")\n",
        "print(\"=\" * 60)\n",
        "\n",
